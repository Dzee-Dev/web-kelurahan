# Server
PORT=3000
NODE_ENV=production

# PostgreSQL
DATABASE_URL=postgresql://kelurahan_user:YOUR_PASSWORD@localhost:5432/web_kelurahan

# Backend public URL (IP atau domain VPS Anda)
BACKEND_URL=http://YOUR_VPS_IP:3000

# WhatsApp Bot
ENABLE_WA_BOT=true
WA_ADMIN_PHONE=628xxxxxxxxxx

# Gemini AI (opsional — bisa dikosongkan, akan fallback ke knowledge base lokal)
GEMINI_API_KEY=

# CORS
FRONTEND_URL=http://YOUR_VPS_IP:3001
