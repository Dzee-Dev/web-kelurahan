# Server
PORT=3000
NODE_ENV=production

# Autentikasi admin
# Buat hash dengan: npm run hash:admin -- "password-kuat-anda"
ADMIN_PASSWORD_HASH=scrypt:PASTE_SALT_DAN_HASH_DARI_PERINTAH_DI_ATAS
# Buat secret acak minimal 32 karakter, contoh: openssl rand -base64 48
SESSION_SECRET=PASTE_SECRET_ACAK_MINIMAL_32_KARAKTER
# true di VPS HTTPS, false hanya untuk development lokal HTTP
COOKIE_SECURE=true

# PostgreSQL
DATABASE_URL=postgresql://kelurahan_user:YOUR_PASSWORD@localhost:5432/web_kelurahan

# Backend public URL (IP atau domain VPS Anda)
BACKEND_URL=http://YOUR_VPS_IP:3000

# WhatsApp Bot
ENABLE_WA_BOT=true
WA_ADMIN_PHONE=6285287434646

# Gemini AI (opsional — bisa dikosongkan, akan fallback ke knowledge base lokal)
GEMINI_API_KEY=

# CORS
FRONTEND_URL=http://YOUR_VPS_IP:3001
